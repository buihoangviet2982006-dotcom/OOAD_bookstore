# Copy thành apps/api/.env khi chạy API / Prisma CLI ngay trên máy (không qua Docker).
# Port host 5433 = POSTGRES_PORT trong .env ở root (Postgres chạy trong Docker Compose).
# Trong Docker, Compose tự truyền DATABASE_URL trỏ tới postgres:5432 – không dùng file này.
PORT=3001
DATABASE_URL=postgresql://bookstore:bookstore_secret@localhost:5433/ooad_bookstore?schema=public

# Xác thực. JWT_SECRET bắt buộc, tối thiểu 32 ký tự ngẫu nhiên – tự sinh, KHÔNG commit giá trị thật.
#   PowerShell: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Thời hạn access token (phút), mặc định 480 = 1 ca làm việc.
JWT_EXPIRES_MINUTES=480
# true = in OTP quên mật khẩu ra console máy chủ (chỉ demo local; tự tắt khi NODE_ENV=production).
AUTH_DEMO_OTP_LOG=false
