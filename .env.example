# Biến cho Docker Compose (copy thành .env ở thư mục gốc). KHÔNG commit file .env thật.

# Tiền tố tên container – đổi khi cần chạy môi trường thứ hai song song (kèm `docker compose -p <tên>`).
CONTAINER_PREFIX=ooad_bookstore

# PostgreSQL. POSTGRES_PORT là cổng trên máy host; đổi (vd 5433) nếu máy đã có PostgreSQL ở 5432.
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore_secret
POSTGRES_DB=ooad_bookstore
POSTGRES_PORT=5432

# NestJS API – API_PORT là cổng trên máy host (trong container luôn 3001).
# DATABASE_URL do Compose tự ghép từ các biến POSTGRES_* (host "postgres" trong mạng Docker).
API_PORT=3001
# Bắt buộc, >= 32 ký tự ngẫu nhiên; tự sinh, không commit giá trị thật:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# Next.js Web. NEXT_PUBLIC_API_URL là địa chỉ API mà TRÌNH DUYỆT truy cập (http://localhost:<API_PORT>),
# được nhúng lúc build image web – đổi API_PORT thì đổi cả biến này và build lại (`--build`).
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
